# Скопируйте этот файл в `.env` и заполните своими значениями.
# Никогда не коммитьте `.env` — он в .gitignore.

# --- Безопасность (A3) ----------------------------------------------------
# Сгенерировать новый случайный ключ:
#   python -c "import secrets; print(secrets.token_hex(32))"
# В production переменная ОБЯЗАТЕЛЬНА — без неё приложение откажется стартовать.
SECRET_KEY=замените_на_64_символа_из_secrets.token_hex_32

# --- База данных (A11) ----------------------------------------------------
# Локально через Docker Compose:
DATABASE_URL=postgresql://gardarika:SP129sGZFHNC@localhost:5432/gardarika_db
# При желании можно явно ограничить таймаут подключения (приложение и так
# использует connect_timeout=10 для PostgreSQL, но можно задать больше):
# DATABASE_URL=postgresql://user:pass@host:5432/db?connect_timeout=10

# Для разработки/SQLite:
# DATABASE_URL=sqlite:///local.db

# --- Режим запуска --------------------------------------------------------
# В production Gunicorn должен запускаться с этой переменной, чтобы
# initialize_database() выполнился ровно один раз:
# GUNICORN_MAIN=1
# Также делает обязательной переменную SECRET_KEY:
# FLASK_ENV=production
